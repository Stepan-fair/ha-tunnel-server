FROM golang:1.26.8-bookworm@sha256:a688600ca24f8a4d3ca77f95b0dd40704a9fc787c826660eb7ba0b641b8b175d AS frp-builder
COPY tools/build_frp.sh /build-frp.sh
RUN sh /build-frp.sh
FROM python:3.13-slim-trixie@sha256:3dd7cc108ec1493442514f5c2a871af6af0ec31d768ff6e378a93340c3b3db5f
WORKDIR /workspace
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends nginx mosquitto && rm -rf /var/lib/apt/lists/*
COPY requirements-dev.lock ./
RUN pip install --no-cache-dir --require-hashes --only-binary=:all: -r requirements-dev.lock
COPY tools/fetch_frp.py tools/frp_versions.json ./tools/
COPY --from=frp-builder /out/frps /out/frpc /usr/local/bin/
COPY --from=frp-builder /out/LICENSE /out/go.mod /out/go.sum /out/frps-build.txt /out/frpc-build.txt /out/frps-vulncheck.txt /out/frpc-vulncheck.txt /usr/share/doc/frp/
COPY --from=frp-builder /out/licenses /usr/share/doc/frp/licenses
COPY --from=frp-builder /out/module-notices.txt /usr/share/doc/frp/
COPY server ./server
COPY client ./client
COPY shared ./shared
COPY tests ./tests
COPY pytest.ini ./
COPY tools ./tools
COPY requirements.lock repository.yaml README.md LICENSE SECURITY.md THIRD_PARTY.md ./
COPY docs ./docs
CMD ["python", "-m", "pytest", "-q", "--tb=short"]
